# Copy this file to .env and replace the placeholders with your own credentials.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# Use a strong random password of at least 16 characters for admin sign-in.
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Optional legacy key for existing API clients.
ADMIN_SYNC_KEY=replace-with-a-long-random-secret

PORT=3001
