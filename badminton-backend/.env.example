# Your Turso database URL (from `turso db show <db-name> --url`)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io

# Your Turso database auth token (keep secret, never commit to GitHub)
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional shared key to protect tournament state writes
ADMIN_SYNC_KEY=

PORT=3001
